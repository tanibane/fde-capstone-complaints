# Clearview Complaints Management — Environment Variables
# Copy to .env and fill in real values before running

# PostgreSQL
DATABASE_URL=postgresql://clearview:clearview_dev@localhost:5432/complaints

# Anthropic Claude via IBM proxy
ANTHROPIC_BASE_URL=https://your-ibm-proxy-endpoint
ANTHROPIC_AUTH_TOKEN=your-auth-token-here

# Backend
PORT=3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Context Studio (ICA — optional, mocked if not set)
CONTEXT_STUDIO_ENDPOINT=https://context-studio.ica.ibm.com/query
CONTEXT_STUDIO_API_KEY=your-ica-key-here

# Notification (mocked in capstone)
NOTIFICATION_SMTP_HOST=smtp.clearview-internal
